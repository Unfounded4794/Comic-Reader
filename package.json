{
  "name": "panel-reader",
  "productName": "Panel Reader",
  "version": "0.3.0",
  "description": "An offline comic reader with guided panels and continuous webtoon reading.",
  "author": "Panel Reader contributors",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:samples": "node scripts/validate-samples.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "models": "node scripts/download-models.mjs",
    "pack:win": "npm run build && electron-builder --config electron-builder.config.cjs --win portable --x64",
    "pack:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux AppImage tar.gz --x64",
    "pack:linux:tar": "npm run build && electron-builder --config electron-builder.config.cjs --linux --dir --x64 && node scripts/linux-tar.mjs",
    "pack:source": "node scripts/source-release.mjs"
  },
  "dependencies": {
    "node-unrar-js": "2.0.2",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "tar": "7.5.22",
    "vite": "8.3.1",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "org.panelreader.desktop",
    "productName": "Panel Reader",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "core/**/*", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
    "extraResources": [{ "from": "models", "to": "models", "filter": ["*.onnx", "*.json", "*.md"] }],
    "extraFiles": [{ "from": "README.md", "to": "README.md" }, { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }],
    "asarUnpack": ["node_modules/sharp/**/*", "node_modules/@img/**/*", "node_modules/onnxruntime-node/**/*", "node_modules/node-unrar-js/**/*"],
    "npmRebuild": false,
    "win": { "target": ["portable"], "signExecutable": false },
    "portable": { "artifactName": "Panel-Reader-${version}-Windows-${arch}.exe" },
    "linux": { "target": ["AppImage", "tar.gz"], "category": "Graphics", "executableName": "panel-reader", "artifactName": "Panel-Reader-${version}-Linux-${arch}.${ext}" }
  }
}
